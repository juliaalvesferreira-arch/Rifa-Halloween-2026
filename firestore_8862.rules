rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Único administrador autorizado da rifa.
    // Obs.: não exigimos email_verified porque contas criadas manualmente
    // no console do Firebase nascem sem verificação, o que travaria o login.
    function ehAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() == 'julia.aferreira@voeazul.com.br';
    }

    // Estado dos 300 números. Leitura pública (grade da página).
    // Qualquer visitante pode gravar — necessário para marcar números como
    // "pendente" no momento da reserva, via transação. A transição para
    // "vendido" é feita pelo admin.html, que exige o login acima.
    // Veja a ressalva de segurança no README.
    match /estado/numeros {
      allow read: if true;
      allow write: if true;
    }

    // Solicitações de reserva.
    match /solicitacoes/{id} {
      // Qualquer visitante pode criar uma solicitação pendente,
      // desde que com os campos esperados.
      allow create: if request.resource.data.status == 'pendente'
        && request.resource.data.nome is string
        && request.resource.data.email is string
        && request.resource.data.celular is string
        && request.resource.data.numeros is list
        && request.resource.data.numeros.size() > 0;

      // Ler a lista de compradores e aprovar/negar: só o administrador.
      allow read, update, delete: if ehAdmin();
    }
  }
}
